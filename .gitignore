"Week3-Two-Tier-Application/infrastructure/terraform.tfvars" 
# Terraform working directories and state files
**/.terraform/
**/.terraform*
**/terraform.tfstate
**/terraform.tfstate*
**/terraform.tfstate.*
**/.terraform.tfstate.lock.info

# Terraform plans and crash logs
*.tfplan
*.tfplan.json
crash.log
crash.*.log

# Local variable values and sensitive credentials (matches all subdirectories)
**/*.tfvars
!**/*.tfvars.example
**/*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Terraform dependency lock files
**/.terraform.lock.hcl

# Local secrets and SSH keys
*.pem
*.id_rsa
*.pub

# OS and IDE temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/